# -*- mode: python ; coding: utf-8 -*-
import os
import subprocess

try:
    _spec_dir = SPECPATH  # noqa: F821  provided by PyInstaller
except NameError:
    _spec_dir = os.getcwd()


def _git_describe():
    try:
        out = subprocess.run(
            ["git", "describe", "--tags", "--always", "--dirty"],
            cwd=_spec_dir,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return "unknown"
    return out or "unknown"


with open(os.path.join(_spec_dir, "_build_info.py"), "w", encoding="utf-8") as _f:
    _f.write("# auto-generated by cn_diag_tool.spec, do not edit\n")
    _f.write(f'COMMIT = "{_git_describe()}"\n')


